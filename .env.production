# Build-time environment for production builds.
#
# Why this file is committed, when `.env.local` is not:
#
# Every variable here is `NEXT_PUBLIC_`, which means Next inlines it into the
# JavaScript that is served to every visitor. They are not secrets and cannot be
# made into secrets — anyone can read them with View Source. The same EmailJS
# values are already in the committed `.env.example` for exactly that reason.
#
# The alternative was setting these in the Cloudflare dashboard as build
# variables. That works too, but it puts the values somewhere the repository
# cannot see, and a missing one fails silently: the build succeeds and the
# contact form is simply dead in production. Committed here, the build is
# reproducible by anyone who clones the repo.
#
# Anything genuinely secret must NOT go in this file. It belongs in a Cloudflare
# Worker secret (`wrangler secret put`), read server-side only.
#
# EmailJS is protected by account configuration, not by hiding these values:
# set the allowed-domain list under Account > Security in the EmailJS dashboard
# so another origin cannot send mail using them.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_aero
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_aero
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=Ibno_icKN2yGTKBam

# The origin the site is actually served from. Canonical URLs, the sitemap,
# robots.txt, llms.txt and the JSON-LD all derive from this, so if it disagrees
# with the address the server answers on, every canonical points at a redirect.
# Change this the moment the custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://www.aerointelli.com
