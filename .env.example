# Contact form delivery (EmailJS).
# All three values are public by design — they ship in the browser bundle.
# Protect the account by setting the allowed domain list in the EmailJS
# dashboard (Account > Security > Allow-list) and enabling reCAPTCHA/rate limits.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_aero
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_aero
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=Ibno_icKN2yGTKBam

# Optional spam protection on the review step.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
