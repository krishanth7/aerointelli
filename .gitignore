# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is the one exception, and has to be committed: it is the only
# record of which variables the app needs in order to run. It carries variable
# names and placeholder values, never a real secret.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
